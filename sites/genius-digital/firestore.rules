rules_version = '2';
// GENIUS DIGITAL (projek Firebase dikongsi) — rules Firestore gabungan:
// Genius Digital (products) | Malaysia PDF Tools | Streamverse Gaming | CodeLab Developer | Invoice Digital (inv_) | Malaysia Image Tools (mit_)
// Setiap aplikasi mengekalkan peraturan asalnya; fungsi bantu dinamakan semula dengan awalan (pdf/sv/cl).
// Genius Digital memerlukan: gdIsAdmin(), koleksi genius_site, dan products guna gdIsAdmin() — JANGAN dipadam semasa mengemas kini rules app lain.
// PENTING: fail ini ialah SATU-SATUNYA rules untuk projek. `firebase deploy --only firestore:rules` menggantikan
// semua; sentiasa mulakan dari rules semasa projek (firebase_get_security_rules) sebelum mengubah.
service cloud.firestore {
  match /databases/{database}/documents {


    // ---------- Helper functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Pengesahan (login) sahaja BUKAN bukti admin. Claim "admin" mesti true.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidStatus(value) {
      return value in ['active', 'coming-soon', 'hidden'];
    }

    // Medan yang dibenarkan dalam dokumen produk (selain ini ditolak).
    function hasOnlyAllowedKeys(data) {
      return data.keys().hasOnly([
        'name', 'slug', 'category', 'description',
        'thumbnailURL',
        'status', 'productURL', 'displayOrder',
        'nameEn', 'categoryEn', 'descriptionEn',
        'nameAr', 'categoryAr', 'descriptionAr',
        'createdAt', 'updatedAt'
      ]);
    }

    function hasRequiredKeys(data) {
      return data.keys().hasAll([
        'name', 'slug', 'category', 'description',
        'thumbnailURL', 'status', 'productURL', 'displayOrder',
        'createdAt', 'updatedAt'
      ]);
    }

    // URL kosong atau https:// sahaja (halang javascript: dsb.).
    function isEmptyOrHttps(value) {
      return value is string && (value == '' || value.matches('https://.*'));
    }

    // Teks terjemahan (BI / BA) adalah pilihan; jika ada mestilah string dalam had panjang.
    function optString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // Thumbnail disimpan terus dalam Firestore (tiada Firebase Storage):
    // kosong, URL https://, atau data URL imej JPEG/PNG/WebP (dimampatkan ≈100 KB oleh admin.html).
    function isValidThumbnail(value) {
      return value is string && value.size() <= 150000
        && (value == '' || value.matches('https://.*') || value.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }

    function hasValidFields(data, docId) {
      return hasOnlyAllowedKeys(data)
        && hasRequiredKeys(data)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.slug is string && data.slug == docId
        && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && data.slug.size() <= 80
        && data.category is string && data.category.size() > 0 && data.category.size() <= 60
        && data.description is string && data.description.size() <= 1000
        && isValidThumbnail(data.thumbnailURL)
        && optString(data, 'nameEn', 120) && optString(data, 'categoryEn', 60) && optString(data, 'descriptionEn', 1000)
        && optString(data, 'nameAr', 120) && optString(data, 'categoryAr', 60) && optString(data, 'descriptionAr', 1000)
        && isValidStatus(data.status)
        && isEmptyOrHttps(data.productURL) && data.productURL.size() <= 2048
        && data.displayOrder is number
        && data.displayOrder >= 0 && data.displayOrder <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------- Koleksi: products ----------
    match /products/{productId} {

      // Baca satu dokumen: produk awam, atau admin (termasuk hidden).
      allow get: if gdIsAdmin() || resource.data.status in ['active', 'coming-soon'];

      // Senarai/query: admin boleh semua. Orang awam MESTI query dengan
      //   where('status', 'in', ['active', 'coming-soon'])
      allow list: if gdIsAdmin() || resource.data.status in ['active', 'coming-soon'];

      // Cipta: admin sahaja, ID dokumen == slug, createdAt/updatedAt == masa pelayan.
      allow create: if gdIsAdmin()
        && hasValidFields(request.resource.data, productId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Kemas kini: admin sahaja, slug & createdAt tidak boleh diubah.
      allow update: if gdIsAdmin()
        && hasValidFields(request.resource.data, productId)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Padam: admin sahaja.
      allow delete: if gdIsAdmin();
    }

    // ---------- Genius Digital: pentadbir (claim admin ATAU e-mel pemilik). Hanya untuk products & genius_site. ----------
    function gdIsAdmin() {
      return isSignedIn() && (request.auth.token.admin == true
        || request.auth.token.email == 'izzulmedia01@gmail.com');
    }

    // ---------- Koleksi: genius_site (tetapan laman awam Genius Digital: logo, jenama, hubungan, teks) ----------
    match /genius_site/{docId} {
      allow read: if true;
      allow write: if gdIsAdmin() && docId == 'main'
        && request.resource.data.keys().hasOnly(['logoURL', 'brandName', 'tagline', 'contact', 'texts', 'updatedAt'])
        && (!('logoURL' in request.resource.data) || isValidThumbnail(request.resource.data.logoURL))
        && (!('brandName' in request.resource.data) || (request.resource.data.brandName is string && request.resource.data.brandName.size() <= 60))
        && (!('tagline' in request.resource.data) || (request.resource.data.tagline is string && request.resource.data.tagline.size() <= 120))
        && (!('contact' in request.resource.data) || request.resource.data.contact is map)
        && (!('texts' in request.resource.data) || request.resource.data.texts is map);
    }


    // ================= MALAYSIA PDF TOOLS =================

    function pdfIsAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }



    // Senarai pentadbir: pengguna boleh semak dokumen sendiri; tiada tulisan dari klien.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || pdfIsAdmin());
      allow write: if false;
    }

    // Tetapan laman awam (pengumuman, alat ditutup / akan datang)
    match /settings/{docId} {
      allow read: if true;
      allow write: if pdfIsAdmin()
        && request.resource.data.keys().hasOnly(['announcement', 'disabledTools', 'comingSoon', 'updatedAt'])
        && (!('disabledTools' in request.resource.data) || request.resource.data.disabledTools is list)
        && (!('comingSoon' in request.resource.data) || request.resource.data.comingSoon is list);
    }

    // Maklum balas tanpa log masuk — disahkan ketat
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'toolId', 'rating', 'message', 'lang', 'createdAt'])
        && request.resource.data.type in ['feedback', 'bug', 'request']
        && request.resource.data.toolId is string && request.resource.data.toolId.size() <= 40
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.lang in ['ms', 'en', 'ar']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if pdfIsAdmin();
      allow update: if pdfIsAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // ================= STREAMVERSE GAMING =================

    // Pendaftaran tanpa pengesahan email (atas permintaan pemilik): cukup dengan log masuk.
    function verified() { return isSignedIn(); }
    function svOwner(uid) { return verified() && request.auth.uid == uid; }
    function data() { return request.resource.data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function onlyChanged(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- Data peribadi pengguna ----------
    match /users/{uid} {
      allow read: if svOwner(uid) || isAdmin();
      allow create: if svOwner(uid) && data().uid == uid && data().email == request.auth.token.email
                    && !data().keys().hasAny(['admin', 'role']);
      allow update: if svOwner(uid) && onlyChanged(['updatedAt', 'lastLoginAt', 'displayName']);
      allow delete: if false;

      match /settings/{id}      { allow read, write: if svOwner(uid); }
      match /themes/{id}        { allow read, write: if svOwner(uid); }
      match /audioSettings/{id} { allow read, write: if svOwner(uid); }
      match /devices/{id}       { allow read, write: if svOwner(uid); }
      match /sources/{id}       { allow read, write: if svOwner(uid); }
      match /scenes/{id} {
        allow read, delete: if svOwner(uid);
        allow create, update: if svOwner(uid) && data().ownerUid == uid && str(data().name, 1, 40)
                              && data().sources is list && data().sources.size() <= 40;
      }
      match /streamSettings/{platform} {
        allow read: if svOwner(uid);
        allow write: if svOwner(uid) && platform in ['tiktok', 'youtube', 'facebook'] && data().ownerUid == uid
                     && str(data().title, 0, 100) && str(data().description, 0, 5000);
      }
      match /recordings/{id} {
        allow read, delete: if svOwner(uid);
        allow create: if svOwner(uid) && data().ownerUid == uid && data().size is int
                      && data().storagePath.matches('users/' + uid + '/recordings/.*');
        allow update: if false;
      }
      match /activity/{id} {
        allow read, delete: if svOwner(uid);
        allow create: if svOwner(uid) && data().ownerUid == uid && str(data().text, 1, 200);
        allow update: if false;
      }
      // WebRTC signaling (pairing telefon) — hanya pemilik akaun (telefon log masuk akaun sama)
      match /pairings/{code} {
        allow read, create, update, delete: if svOwner(uid);
        match /{sub}/{cand} { allow read, create, delete: if svOwner(uid) && sub in ['offerCandidates', 'answerCandidates']; }
      }
      // Ditulis oleh Cloud Functions sahaja (token disahkan di backend)
      match /platformConnections/{platform} { allow read: if svOwner(uid) || isAdmin(); allow write: if false; }
      match /aiAssets/{id}                  { allow read: if svOwner(uid); allow write: if false; }
      // Kill events: auto (Functions, dari webhook game) atau manual (Kill Remote milik akaun sama)
      match /gameEvents/{id} {
        allow read, delete: if svOwner(uid);
        allow create: if svOwner(uid) && data().type == 'kill' && data().source == 'manual'
                      && str(data().game, 1, 20) && data().headshot is bool && data().createdAt == request.time;
        allow update: if false;
      }
      match /followers/{followerUid}        { allow read: if verified(); allow write: if false; }
      match /notifications/{id} {
        allow read, delete: if svOwner(uid);
        allow update: if svOwner(uid) && onlyChanged(['read']) && data().read is bool;
        allow create: if false;
      }
      match /following/{targetUid} {
        allow read: if svOwner(uid);
        allow create: if svOwner(uid) && targetUid != uid && data().targetUid == targetUid && data().ownerUid == uid;
        allow delete: if svOwner(uid);
        allow update: if false;
      }
      match /communityPosts/{postId} {
        allow read: if verified();
        allow create: if svOwner(uid) && data().ownerUid == uid && str(data().text, 1, 2000) && str(data().game, 0, 60)
                      && data().likeCount == 0 && data().commentCount == 0 && data().createdAt == request.time;
        allow update: if svOwner(uid) && onlyChanged(['text', 'game', 'gameLower']) && str(data().text, 1, 2000);
        allow delete: if svOwner(uid) || isAdmin();
        match /likes/{likerUid} {
          allow read: if verified();
          allow create: if verified() && likerUid == request.auth.uid && data().ownerUid == likerUid;
          allow delete: if verified() && likerUid == request.auth.uid;
          allow update: if false;
        }
        match /comments/{commentId} {
          allow read: if verified();
          allow create: if verified() && data().ownerUid == request.auth.uid && str(data().text, 1, 500);
          allow delete: if verified() && (resource.data.ownerUid == request.auth.uid || request.auth.uid == uid || isAdmin());
          allow update: if false;
        }
      }
    }
    // Feed global (collection group query)
    match /{path=**}/communityPosts/{postId} { allow read: if verified(); }

    // ---------- Profil awam gamer ----------
    match /profiles/{uid} {
      allow read: if verified();
      allow create: if svOwner(uid) && data().ownerUid == uid && !data().keys().hasAny(['followerCount', 'followingCount'])
                    && data().username.matches('^[A-Za-z0-9_]{3,20}$') && str(data().bio, 0, 300);
      allow update: if svOwner(uid) && !data().diff(resource.data).affectedKeys().hasAny(['followerCount', 'followingCount', 'ownerUid'])
                    && data().username.matches('^[A-Za-z0-9_]{3,20}$') && str(data().bio, 0, 300);
      allow delete: if false;
    }
    match /usernames/{name} {
      allow read: if verified();
      allow create: if verified() && name.matches('^[a-z0-9_]{3,20}$') && data().uid == request.auth.uid;
      allow update: if verified() && resource.data.uid == request.auth.uid && data().uid == request.auth.uid;
      allow delete: if verified() && resource.data.uid == request.auth.uid;
    }
    match /groups/{gid} {
      allow read: if verified();
      allow create: if verified() && data().ownerUid == request.auth.uid && str(data().name, 1, 50) && data().memberCount == 0;
      allow update: if false;
      allow delete: if verified() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      match /members/{memberUid} {
        allow read: if verified();
        allow create, delete: if verified() && memberUid == request.auth.uid;
        allow update: if false;
      }
    }
    // Halaman live awam + link donation (dibaca viewer tanpa login)
    match /publicPages/{uid} {
      allow read: if true;
      allow create: if svOwner(uid) && data().ownerUid == uid && data().disabled == false
                    && data().slug == get(/databases/$(database)/documents/profiles/$(uid)).data.usernameLower
                    && data().links is list && data().links.size() <= 8 && str(data().displayName, 1, 40);
      allow update: if (svOwner(uid) && data().ownerUid == uid && data().disabled == resource.data.disabled
                        && data().slug == get(/databases/$(database)/documents/profiles/$(uid)).data.usernameLower
                        && data().links is list && data().links.size() <= 8)
                    || (isAdmin() && onlyChanged(['disabled']));
      allow delete: if svOwner(uid) || isAdmin();
    }
    match /reports/{id} {
      allow create: if verified() && data().reporterUid == request.auth.uid && data().status == 'open' && str(data().details, 0, 500);
      allow read, update, delete: if isAdmin();
    }

    // ---------- Sistem / admin ----------
    match /announcements/{id} { allow read: if verified(); allow write: if isAdmin(); }
    match /config/{id}        { allow read: if verified(); allow write: if isAdmin(); }
    match /systemLogs/{id}    { allow read: if isAdmin(); allow write: if false; }
    match /aiUsage/{id}       { allow read, write: if false; }
    match /_private/{doc=**}  { allow read, write: if false; }   // token OAuth (disulitkan), state OAuth

    // ================= CODELAB DEVELOPER =================
    // Semua koleksi berawalan `codelab_`. Admin = isAdmin() di atas (custom claim admin=true sahaja).
    //
    // Statistik agregat (tiada data peribadi). Bacaan awam untuk footer. Klien awam hanya boleh:
    //  - mencipta dokumen kiraan dengan visits == 1, atau
    //  - menaikkan visits sebanyak tepat +1.
    // Kunci harian/bulanan = tarikh waktu Malaysia (dikira di klien oleh js/statistics/kl-time.js).
    // Untuk produksi tinggi trafik: aktifkan App Check atau pindahkan ke Cloud Function.
    function clBump() {
      return request.resource.data.keys().hasOnly(['visits'])
        && request.resource.data.visits is int
        && request.resource.data.visits == resource.data.visits + 1;
    }
    function clFirst() {
      return request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
    }
    match /codelab_stats/{doc} {
      allow read: if true;
      allow create: if doc == 'total' && clFirst();
      // registeredUsers hanya boleh diubah oleh admin; orang awam hanya +1 pada visits.
      allow update: if isAdmin() || (doc == 'total'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
        && request.resource.data.visits == resource.data.visits + 1);
      allow delete: if isAdmin();
    }
    match /codelab_stats_daily/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && clFirst();
      allow update: if isAdmin() || clBump();
      allow delete: if isAdmin();
    }
    match /codelab_stats_monthly/{month} {
      allow read: if true;
      allow create: if month.matches('^[0-9]{4}-[0-9]{2}$') && clFirst();
      allow update: if isAdmin() || clBump();
      allow delete: if isAdmin();
    }
    // Konfigurasi & kandungan awam: baca bebas, tulis admin sahaja.
    match /codelab_config/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc in ['tools', 'site']
        && request.resource.data.keys().hasOnly(['disabled', 'name', 'logo', 'slogan', 'footer', 'languages', 'defaultLang', 'maintenance', 'brand', 'updatedAt'])
        && (!('disabled' in request.resource.data) || (request.resource.data.disabled is list && request.resource.data.disabled.size() <= 200));
    }
    match /codelab_content/{doc} { allow read: if true; allow write: if isAdmin(); }
    // Log aktiviti & pengguna CodeLab: admin sahaja.
    match /codelab_activity/{id} { allow read: if isAdmin(); allow create: if isAdmin() && request.resource.data.keys().hasOnly(['type', 'detail', 'actor', 'at']); allow update, delete: if false; }
    match /codelab_users/{uid}   { allow read, write: if isAdmin(); }

    // ================= INVOICE DIGITAL & QUOTATION (awalan inv_) =================
    // Ditambah tanpa mengubah rules aplikasi lain. Admin = isAdmin() (custom claim admin=true) di atas.
    // Data pengguna: inv_users/{uid}/{customers|products|invoices|quotations|receipts|meta|counters}/{id}
    function invActive(uid) {
      return !(exists(/databases/$(database)/documents/inv_users/$(uid))
        && get(/databases/$(database)/documents/inv_users/$(uid)).data.get('disabled', false) == true);
    }
    function invOwner(uid) { return isSignedIn() && request.auth.uid == uid && invActive(uid); }
    function invNew() { return request.resource.data; }
    function invBase(uid) { return invNew().ownerUid == uid && invNew().keys().size() <= 40; }
    function invBump(k) {
      return request.resource.data.keys().hasOnly([k]) && request.resource.data[k] is int
        && request.resource.data[k] == resource.data[k] + 1;
    }
    function invFirst(k) { return request.resource.data.keys().hasOnly([k]) && request.resource.data[k] == 1; }
    function invBool(v) { return v is bool; }

    match /inv_users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      // Pengguna cipta profil sendiri sahaja; tiada medan role/admin/disabled dibenarkan.
      allow create: if isSignedIn() && request.auth.uid == uid
        && invNew().keys().hasOnly(['uid', 'email', 'displayName', 'lang', 'createdAt', 'lastLoginAt'])
        && invNew().uid == uid
        && invNew().email == request.auth.token.get('email', '')
        && invNew().displayName is string && invNew().displayName.size() <= 80
        && invNew().lang in ['ms', 'en']
        && invNew().createdAt == request.time && invNew().lastLoginAt == request.time;
      allow update: if
        (invOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lang', 'lastLoginAt', 'updatedAt'])
          && (!('displayName' in invNew()) || (invNew().displayName is string && invNew().displayName.size() <= 80))
          && invNew().lang in ['ms', 'en'])
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled', 'updatedAt'])
          && invBool(invNew().disabled));
      allow delete: if false;

      // Bacaan: pemilik (aktif) atau admin. Tulisan: ikut koleksi di bawah.
      match /{sub}/{id} {
        allow get, list: if (invOwner(uid) || isAdmin())
          && sub in ['customers', 'products', 'invoices', 'quotations', 'receipts', 'meta', 'counters'];
        allow create, update: if invOwner(uid) && sub in ['customers', 'products', 'meta'] && invBase(uid);
        allow delete: if invOwner(uid) && sub in ['customers', 'products'];
      }
      match /invoices/{id} {
        allow create: if invOwner(uid) && invBase(uid)
          && invNew().status in ['draft', 'sent', 'unpaid', 'partial', 'paid', 'cancelled']
          && invNew().items is list && invNew().items.size() <= 150
          && invNew().number is string && invNew().number.size() <= 40
          && invNew().createdAt == request.time;
        allow update: if invOwner(uid) && invBase(uid) && resource.data.ownerUid == uid
          && invNew().status in ['draft', 'sent', 'unpaid', 'partial', 'paid', 'cancelled']
          && invNew().items is list && invNew().items.size() <= 150
          && invNew().number == resource.data.number && invNew().createdAt == resource.data.createdAt;
        allow delete: if invOwner(uid);   // pemilik boleh padam projek sendiri (UI minta pengesahan)
      }
      match /quotations/{id} {
        allow create: if invOwner(uid) && invBase(uid)
          && invNew().status in ['draft', 'sent', 'accepted', 'rejected', 'expired', 'converted']
          && invNew().items is list && invNew().items.size() <= 150
          && invNew().number is string && invNew().number.size() <= 40
          && invNew().createdAt == request.time;
        allow update: if invOwner(uid) && invBase(uid) && resource.data.ownerUid == uid
          && invNew().status in ['draft', 'sent', 'accepted', 'rejected', 'expired', 'converted']
          && invNew().items is list && invNew().items.size() <= 150
          && invNew().number == resource.data.number && invNew().createdAt == resource.data.createdAt;
        allow delete: if invOwner(uid);   // pemilik boleh padam projek sendiri (UI minta pengesahan)
      }
      // Resit: tidak boleh diubah selepas dicipta (integriti rekod); boleh dipadam oleh pemilik.
      match /receipts/{id} {
        allow create: if invOwner(uid) && invBase(uid)
          && invNew().amount is number && invNew().amount > 0
          && invNew().number is string && invNew().number.size() <= 40
          && invNew().createdAt == request.time;
        // Padam resit dibenarkan (app memulihkan baki invoice dalam transaksi); tidak boleh diubah.
        allow delete: if invOwner(uid);
      }
      // Kaunter nombor dokumen: hanya naik tepat +1 (digunakan dalam transaksi bersama dokumen).
      match /counters/{id} {
        allow create: if invOwner(uid) && invNew().n == 1 && invNew().ownerUid == uid
          && invNew().keys().hasOnly(['n', 'kind', 'year', 'ownerUid']);
        allow update: if invOwner(uid) && invNew().n == resource.data.n + 1 && invNew().ownerUid == uid
          && invNew().keys().hasOnly(['n', 'kind', 'year', 'ownerUid']);
      }
    }

    // Admin: baca semua dokumen pengguna melalui collection group (untuk kiraan statistik).
    match /{path=**}/invoices/{id}   { allow read: if isAdmin(); }
    match /{path=**}/quotations/{id} { allow read: if isAdmin(); }
    match /{path=**}/receipts/{id}   { allow read: if isAdmin(); }
    match /{path=**}/customers/{id}  { allow read: if isAdmin(); }

    // Statistik awam (footer). Waktu Malaysia dikira di klien (kunci YYYY-MM-DD / YYYY-MM).
    match /inv_stats/{doc} {
      allow read: if true;
      allow create: if (doc == 'total' && invFirst('visits'))
        || (doc == 'users' && isSignedIn() && invFirst('count')
            && existsAfter(/databases/$(database)/documents/inv_users/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/inv_users/$(request.auth.uid)));
      allow update: if isAdmin()
        || (doc == 'total' && invBump('visits'))
        || (doc == 'users' && isSignedIn() && invBump('count')
            && existsAfter(/databases/$(database)/documents/inv_users/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/inv_users/$(request.auth.uid)));
      allow delete: if isAdmin();
    }
    match /inv_stats_daily/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && invFirst('visits');
      allow update: if isAdmin() || invBump('visits');
      allow delete: if isAdmin();
    }
    match /inv_stats_monthly/{month} {
      allow read: if true;
      allow create: if month.matches('^[0-9]{4}-[0-9]{2}$') && invFirst('visits');
      allow update: if isAdmin() || invBump('visits');
      allow delete: if isAdmin();
    }

    // Konfigurasi & kandungan landing: baca awam, tulis admin sahaja.
    match /inv_settings/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'app'
        && request.resource.data.keys().hasOnly(['appName', 'logo', 'heroTitle', 'heroText', 'intro', 'announcement', 'contactEmail', 'contactPhone', 'numberFormat', 'taxName', 'taxRate', 'terms', 'updatedAt'])
        && (!('appName' in request.resource.data) || (request.resource.data.appName is string && request.resource.data.appName.size() <= 80))
        && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.size() <= 150000
            && (request.resource.data.logo == '' || request.resource.data.logo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))))
        && (!('numberFormat' in request.resource.data) || request.resource.data.numberFormat is map)
        && (!('taxRate' in request.resource.data) || (request.resource.data.taxRate is number && request.resource.data.taxRate >= 0 && request.resource.data.taxRate <= 100));
    }

    // Log aktiviti (untuk dashboard admin) — pengguna hanya boleh menambah log milik sendiri.
    match /inv_activity/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && invActive(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'kind', 'number', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['invoice', 'quotation', 'receipt']
        && request.resource.data.number is string && request.resource.data.number.size() <= 40
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // Log admin: admin sahaja boleh menambah; tiada siapa boleh ubah/padam.
    match /inv_adminLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'detail', 'actor', 'actorEmail', 'at'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ================= MALAYSIA IMAGE TOOLS (koleksi berawalan mit_) =================
    // Admin = akaun yang ada dokumen admins/{uid} (sama seperti Malaysia PDF Tools)
    // ATAU pemilik projek (claim admin / e-mel pemilik). Gambar pengguna TIDAK disimpan di mana-mana.

    function mitIsAdmin() {
      return isSignedIn() && (pdfIsAdmin() || isAdmin());
    }
    function mitIsSite(d) {
      return d.keys().hasOnly(['announcementActive', 'announcement', 'announcementType', 'maintenance', 'maintenanceMessage', 'updatedAt', 'updatedBy'])
        && d.announcementActive is bool
        && d.announcement is string && d.announcement.size() <= 300
        && d.announcementType in ['info', 'success', 'warning']
        && d.maintenance is bool
        && d.maintenanceMessage is string && d.maintenanceMessage.size() <= 300
        && (!('updatedBy' in d) || (d.updatedBy is string && d.updatedBy.size() <= 120));
    }
    function mitIsTool(d) {
      return d.keys().hasOnly(['enabled', 'featured', 'updatedAt'])
        && (!('enabled' in d) || d.enabled is bool)
        && (!('featured' in d) || d.featured is bool);
    }
    function mitIsFeedback(d) {
      return d.keys().hasOnly(['name', 'message', 'tool', 'rating', 'status', 'createdAt'])
        && d.keys().hasAll(['message', 'tool', 'rating', 'status', 'createdAt'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && d.message is string && d.message.size() > 0 && d.message.size() <= 1000
        && d.tool is string && d.tool.size() <= 40
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    // Dokumen "pengawal" untuk semakan akses admin dari klien (boleh dibaca admin sahaja).
    match /mit_private/{id} {
      allow read: if mitIsAdmin();
      allow write: if false;
    }
    match /mit_settings/{id} {
      allow read: if true;
      allow write: if mitIsAdmin() && id == 'site' && mitIsSite(request.resource.data);
    }
    match /mit_tools/{id} {
      allow read: if true;
      allow write: if mitIsAdmin() && id.matches('^[a-z0-9-]{1,40}$') && mitIsTool(request.resource.data);
    }
    match /mit_feedback/{id} {
      allow create: if mitIsFeedback(request.resource.data);
      allow read, delete: if mitIsAdmin();
      allow update: if mitIsAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'read'];
    }

    // Semua laluan lain ditutup.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

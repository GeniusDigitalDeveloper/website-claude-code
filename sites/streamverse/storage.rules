rules_version = '2';
// STREAMVERSE — Firebase Storage Rules. Hanya pemilik; had saiz & jenis fail.
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
    function img(maxMB) { return request.resource.size < maxMB * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)'); }

    match /users/{uid}/avatar/{file} {
      allow read: if request.auth != null;
      allow create, update: if owner(uid) && img(2);
      allow delete: if owner(uid);
    }
    match /users/{uid}/overlays/{file} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && img(5);
      allow delete: if owner(uid);
    }
    match /users/{uid}/recordings/{file} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && (
        (request.resource.contentType.matches('video/(webm|mp4)') && request.resource.size < 1000 * 1024 * 1024) ||
        (request.resource.contentType.matches('audio/(webm|ogg|mp4)') && request.resource.size < 200 * 1024 * 1024));
      allow update: if false;
    }
    match /users/{uid}/ai/{file} {
      allow read: if owner(uid);
      allow write: if false;      // ditulis oleh Cloud Functions (Admin SDK)
    }
    match /{all=**} { allow read, write: if false; }
  }
}

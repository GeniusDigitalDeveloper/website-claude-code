{
  "_nota": "Config penuh untuk pelan Blaze (Cloud Functions + Storage). Guna: firebase deploy --config firebase.blaze.json --only functions,hosting. TIDAK mengandungi rules Firestore kerana rules projek GENIUS DIGITAL dikongsi 4 app.",
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.blaze.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "design-system/**",
      "tools/**",
      "*.rules",
      "*.md",
      "firestore.indexes.json"
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/oauth/callback", "function": { "functionId": "oauthCallback", "region": "asia-southeast1" } },
      { "source": "/hook/game/**", "function": { "functionId": "gameEvent", "region": "asia-southeast1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self)" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
        ]
      }
    ]
  },
  "firestore": { "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs20", "ignore": ["node_modules", ".git", "*.local"] }
  ]
}

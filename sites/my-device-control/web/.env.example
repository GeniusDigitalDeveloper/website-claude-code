# Salin ke .env.local — nilai dari Firebase Console > Project settings > Your apps > Web app
# (ini kunci AWAM; keselamatan dikawal oleh Security Rules + App Check). JANGAN letak service account di sini.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Pilihan: kunci reCAPTCHA v3/Enterprise untuk App Check
NEXT_PUBLIC_APPCHECK_SITE_KEY=

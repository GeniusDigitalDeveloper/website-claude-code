rules_version = '2';

// MY DEVICE CONTROL — Firestore Rules (alat dalaman, satu organisasi)
//  ADMIN  = akaun e-mel/kata laluan (atau Google) yang e-melnya ada dalam config/admins.emails.
//           Senarai ini diurus dari panel (Users & Roles). Sesiapa lain yang berjaya mendaftar akaun
//           TIDAK menjadi admin, jadi sign-up dibuka dengan selamat (diperlukan oleh peranti).
//  PERANTI = agent peranti yang log masuk "Anonymous" dan mendaftar dengan kod enrollment sekali guna,
//           kemudian menunggu admin menekan Sahkan.
//  AWAM    = index.html (tanpa log masuk) hanya membaca koleksi publicStatus (nama, jenis, status, bateri).

service cloud.firestore {
  match /databases/{database}/documents {

    // Senarai e-mel admin (dokumen config/admins, diurus dari panel)
    function adminEmails() { return get(/databases/$(database)/documents/config/admins).data.emails; }

    function signedIn() { return request.auth != null; }
    function provider() { return request.auth.token.firebase.sign_in_provider; }
    function isAdmin() {
      return signedIn() && provider() in ['password', 'google.com'] && 'email' in request.auth.token
        && request.auth.token.email.lower() in adminEmails();
    }
    function isDevice() { return signedIn() && provider() == 'anonymous'; }
    function isThisDevice(deviceId) {
      return isDevice() && request.auth.uid == deviceId && exists(/databases/$(database)/documents/devices/$(deviceId));
    }
    // Peranti hanya aktif selepas admin menekan Terima (enrollmentStatus ENROLLED)
    function approved(id) { return get(/databases/$(database)/documents/devices/$(id)).data.enrollmentStatus == 'ENROLLED'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function enroll(code) { return /databases/$(database)/documents/enrollments/$(code); }

    // ---------- Peranti ----------
    match /devices/{deviceId} {
      allow read: if isAdmin() || isThisDevice(deviceId);

      // Pendaftaran: peranti anonymous + kod enrollment PENDING yang ditanda USED dalam batch yang sama
      allow create: if isDevice() && request.auth.uid == deviceId
        && request.resource.data.keys().hasOnly(['deviceId', 'deviceName', 'deviceType', 'deviceModel', 'osVersion', 'status', 'isLocked',
             'enrollmentStatus', 'assignedUserId', 'groupId', 'batteryLevel', 'lastSeen', 'createdAt', 'updatedAt', 'enrollmentCode', 'appVersion', 'fcmToken'])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.status == 'ENROLLMENT_PENDING' && request.resource.data.enrollmentStatus == 'PENDING_APPROVAL'
        && get(enroll(request.resource.data.enrollmentCode)).data.status == 'PENDING'
        && get(enroll(request.resource.data.enrollmentCode)).data.expiresAt > request.time
        && request.resource.data.deviceName == get(enroll(request.resource.data.enrollmentCode)).data.deviceName
        && request.resource.data.deviceType == get(enroll(request.resource.data.enrollmentCode)).data.deviceType
        && getAfter(enroll(request.resource.data.enrollmentCode)).data.status == 'USED'
        && getAfter(enroll(request.resource.data.enrollmentCode)).data.deviceId == deviceId;

      // Admin: sunting metadata ATAU terima peranti baharu (PENDING_APPROVAL -> ENROLLED).
      // Peranti: heartbeat hanya selepas diterima.
      allow update: if (isAdmin()
          && onlyChanges(['deviceName', 'assignedUserId', 'groupId', 'notes', 'updatedAt'])
          && request.resource.data.deviceName is string
          && request.resource.data.deviceName.size() > 0 && request.resource.data.deviceName.size() <= 80)
        || (isAdmin() && resource.data.enrollmentStatus == 'PENDING_APPROVAL'
          && onlyChanges(['enrollmentStatus', 'status', 'updatedAt'])
          && request.resource.data.enrollmentStatus == 'ENROLLED' && request.resource.data.status == 'ONLINE')
        || (isThisDevice(deviceId) && resource.data.enrollmentStatus == 'ENROLLED'
          && onlyChanges(['status', 'isLocked', 'batteryLevel', 'osVersion', 'appVersion', 'fcmToken', 'lastSeen', 'updatedAt'])
          && request.resource.data.status in ['ONLINE', 'LOCKED', 'ERROR']
          && (!('batteryLevel' in request.resource.data) || request.resource.data.batteryLevel == null
              || (request.resource.data.batteryLevel is number && request.resource.data.batteryLevel >= 0 && request.resource.data.batteryLevel <= 100)));
      allow delete: if isAdmin();

      match /installedApps/{pkg} {
        allow read: if isAdmin();
        allow write: if isThisDevice(deviceId)
          && request.resource.data.keys().hasOnly(['packageName', 'label', 'versionName', 'updatedAt']);
      }
    }

    // ---------- Enrollment (kod = ID dokumen; hanya admin boleh senarai) ----------
    match /enrollments/{code} {
      allow list: if isAdmin();
      // Agent membaca nama/jenis dari enrollment yang masih PENDING (hanya jika tahu kod 32 aksara). Tidak boleh senarai.
      allow get: if isAdmin() || (isDevice() && resource.data.status == 'PENDING');
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['deviceName', 'deviceType', 'groupId', 'assignedUserId', 'status', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.status == 'PENDING' && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.deviceType in ['ANDROID', 'WINDOWS', 'IOS', 'MAC', 'LINUX', 'OTHER']
        && request.resource.data.deviceName is string && request.resource.data.deviceName.size() > 0 && request.resource.data.deviceName.size() <= 80
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'd')
        && code.size() >= 24;
      // Peranti menanda kod USED (sekali guna) bersama pendaftaran dirinya
      allow update: if isDevice() && resource.data.status == 'PENDING' && resource.data.expiresAt > request.time
        && request.resource.data.status == 'USED' && request.resource.data.deviceId == request.auth.uid
        && onlyChanges(['status', 'deviceId', 'usedAt']);
      allow delete: if isAdmin();
    }

    // ---------- Kumpulan ----------
    match /deviceGroups/{groupId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.keys().hasOnly(['name', 'description', 'policyIds', 'createdAt', 'updatedAt', 'createdBy']);
      allow delete: if isAdmin();
    }

    // ---------- Command queue ----------
    match /commands/{commandId} {
      allow read: if isAdmin() || (isDevice() && resource.data.deviceId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['commandId', 'deviceId', 'commandType', 'status', 'createdBy', 'createdAt', 'expiresAt', 'sentAt', 'executedAt', 'errorMessage'])
        && request.resource.data.commandType in ['LOCK', 'UNLOCK', 'REBOOT', 'SYNC_POLICY']
        && request.resource.data.status == 'PENDING' && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.executedAt == null
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(1, 'd')
        && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
        && approved(request.resource.data.deviceId);   // hanya peranti yang telah diterima
      // Peranti sahaja boleh bergerak PENDING → SENT → ACKNOWLEDGED → EXECUTED/FAILED (tidak boleh langkau PENDING → EXECUTED)
      allow update: if isThisDevice(resource.data.deviceId) && approved(resource.data.deviceId) && resource.data.expiresAt > request.time
          && onlyChanges(['status', 'sentAt', 'executedAt', 'errorMessage'])
          && (resource.data.status == 'PENDING' && request.resource.data.status in ['SENT', 'ACKNOWLEDGED']
              || resource.data.status == 'SENT' && request.resource.data.status in ['ACKNOWLEDGED', 'EXECUTED', 'FAILED']
              || resource.data.status == 'ACKNOWLEDGED' && request.resource.data.status in ['EXECUTED', 'FAILED'])
        // Admin hanya boleh membatalkan arahan yang belum dilaksanakan
        || isAdmin() && resource.data.status in ['PENDING', 'SENT'] && onlyChanges(['status', 'errorMessage']) && request.resource.data.status == 'EXPIRED';
      allow delete: if false;
    }

    // ---------- Paparan awam (index.html, tanpa log masuk): hanya maklumat tidak sensitif ----------
    // Tiada pengguna ditetapkan, tiada token, tiada nota. Hanya admin atau peranti berdaftar boleh menulis.
    function validPublic() {
      return request.resource.data.keys().hasOnly(['deviceName', 'deviceType', 'status', 'batteryLevel', 'lastSeen', 'groupName', 'updatedAt'])
        && request.resource.data.deviceName is string && request.resource.data.deviceName.size() > 0 && request.resource.data.deviceName.size() <= 80
        && request.resource.data.deviceType in ['ANDROID', 'WINDOWS', 'IOS', 'MAC', 'LINUX', 'OTHER']
        && request.resource.data.status in ['ONLINE', 'OFFLINE', 'LOCKED', 'ERROR', 'ENROLLMENT_PENDING']
        && (!('batteryLevel' in request.resource.data) || request.resource.data.batteryLevel == null
            || (request.resource.data.batteryLevel is number && request.resource.data.batteryLevel >= 0 && request.resource.data.batteryLevel <= 100))
        && (!('groupName' in request.resource.data) || request.resource.data.groupName == null
            || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 80));
    }
    match /publicStatus/{deviceId} {
      allow read: if true;
      allow create: if isAdmin() && validPublic()
        || isDevice() && request.auth.uid == deviceId && existsAfter(/databases/$(database)/documents/devices/$(deviceId))
           && validPublic() && request.resource.data.status == 'ENROLLMENT_PENDING';
      allow update: if isAdmin() && validPublic()
        || isDevice() && request.auth.uid == deviceId && exists(/databases/$(database)/documents/devices/$(deviceId)) && approved(deviceId) && validPublic();
      allow delete: if isAdmin();
    }

    // ---------- Polisi (Fasa 2/3) ----------
    match /applications/{appId} {
      allow read: if isAdmin() || isDevice();
      allow create, update, delete: if isAdmin();
    }
    match /webFilteringRules/{ruleId} {
      allow read: if isAdmin() || isDevice();
      allow create, update, delete: if isAdmin();
    }

    // ---------- Log aktiviti (tambah sahaja, tidak boleh diubah/dipadam) ----------
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'message', 'actorId', 'deviceId', 'createdAt'])
          && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time
        || isDevice()
          && request.resource.data.keys().hasOnly(['type', 'message', 'actorId', 'deviceId', 'createdAt'])
          && request.resource.data.deviceId == request.auth.uid && request.resource.data.actorId == null
          && request.resource.data.type in ['DEVICE_REGISTERED', 'DEVICE_ONLINE', 'COMMAND_EXECUTED', 'COMMAND_FAILED']
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Senarai admin: hanya admin boleh baca/ubah, dan tidak boleh mengeluarkan dirinya sendiri
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && docId == 'admins'
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt', 'updatedBy'])
        && request.resource.data.emails is list && request.resource.data.emails.size() >= 1 && request.resource.data.emails.size() <= 30
        && request.auth.token.email.lower() in request.resource.data.emails;
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}

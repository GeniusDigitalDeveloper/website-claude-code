rules_version = '2';

// AURALYQO Firestore security rules
// - Every user can only read/write their own data.
// - Admin = Firebase Auth custom claim `admin == true` (set with functions/scripts/set-admin.mjs).
// - Clients can never grant themselves a role, un-suspend themselves, or write other users' data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function onlyKeys(allowed) { return request.resource.data.keys().hasOnly(allowed); }
    function unchanged(k) { return !(k in request.resource.data) || (k in resource.data && request.resource.data[k] == resource.data[k]); }

    // Public profile document
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && onlyKeys(['displayName', 'username', 'email', 'photoURL', 'createdAt', 'role'])
        && request.resource.data.role == 'user'
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80;
      allow update: if (isOwner(uid)
          && onlyKeys(['displayName', 'username', 'email', 'photoURL', 'createdAt', 'role', 'suspended'])
          && unchanged('role') && unchanged('suspended') && unchanged('createdAt')
          && (!('displayName' in request.resource.data) || request.resource.data.displayName.size() <= 80)
          && (!('username' in request.resource.data) || request.resource.data.username.matches('^[a-z0-9._]{0,30}$')))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'role']));
      allow delete: if isOwner(uid) || isAdmin();

      // Synced app data: library (playlists, favourites, recent…), settings, layout. Owner only.
      match /data/{docId} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid) && docId in ['library', 'settings', 'layout'];
      }
    }

    // Admin-curated content (read by everyone, written by admins only)
    match /featured_playlists/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.deezerPlaylistId is string
        && request.resource.data.deezerPlaylistId.matches('^[0-9]{1,20}$');
    }
    match /genres/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Playback error reports (write-only for users, read for admins)
    match /error_logs/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && onlyKeys(['uid', 'trackId', 'message', 'ua', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 300;
      allow read, delete: if isAdmin();
    }

    // Content reports
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && onlyKeys(['uid', 'type', 'detail', 'targetId', 'createdAt'])
        && request.resource.data.detail.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    // Server-only (Cloud Functions with Admin SDK bypass these rules)
    match /rate_limits/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}

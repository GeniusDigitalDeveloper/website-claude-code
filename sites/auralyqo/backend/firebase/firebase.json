{
  "firestore": {
    "rules": "../security-rules/firestore.rules",
    "indexes": "../database/firestore.indexes.json"
  },
  "storage": {
    "rules": "../security-rules/storage.rules"
  },
  "functions": [
    {
      "source": "../functions",
      "codebase": "auralyqo",
      "runtime": "nodejs20",
      "ignore": ["node_modules", ".git", "*.local", "scripts"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pemilik = akaun dengan custom claim admin=true. Admin lain = e-mel yang didaftarkan oleh pemilik dalam koleksi admins.
    // Dua-dua dinilai di sini (bukan di pelayar), jadi pengguna awam tidak boleh menjadikan diri sendiri admin.
    function isOwner() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isAdmin() {
      return isOwner() || (request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    // Tetapan awam (platform, FAQ 3 bahasa, pengumuman): semua boleh baca, admin sahaja boleh tulis.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Statistik: admin baca sahaja. Pelayan muat turun menulis melalui akaun perkhidmatan (tidak tertakluk pada rules).
    // stats/public = jumlah awam untuk footer (tiada data peribadi). Selebihnya admin sahaja.
    match /stats/{doc} {
      allow read: if doc == 'public' || isAdmin();
      allow write: if false;
    }
    match /daily/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Profil pengguna berdaftar. Pengguna boleh cipta rekod sendiri dan tukar gambar/bahasa sahaja.
    // Jumlah muat turun (stats) hanya ditulis oleh pelayan, jadi tidak boleh dipalsukan oleh pengguna.
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'lang', 'photo'])
        && request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'lang'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 150000));
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

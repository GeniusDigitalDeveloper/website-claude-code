rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pemilik = akaun dengan custom claim admin=true. Admin lain = e-mel yang didaftarkan oleh pemilik dalam koleksi admins.
    // Dua-dua dinilai di sini (bukan di pelayar), jadi pengguna awam tidak boleh menjadikan diri sendiri admin.
    function isOwner() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isAdmin() {
      return isOwner() || (request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    // Tetapan awam (platform, FAQ 3 bahasa, pengumuman): semua boleh baca, admin sahaja boleh tulis.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Statistik: admin baca sahaja. Pelayan muat turun menulis melalui akaun perkhidmatan (tidak tertakluk pada rules).
    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /daily/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Profil pengguna berdaftar: pengguna cipta rekod sendiri sahaja, admin boleh baca semua.
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'lang'])
        && request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

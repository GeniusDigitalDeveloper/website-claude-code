{
  "firestore": { "rules": "rules/firestore.rules" },
  "database": { "rules": "rules/database.rules.json" },
  "hosting": { "public": "out", "ignore": ["firebase.json", "**/.*", "**/node_modules/**"], "cleanUrls": true, "trailingSlash": true,
    "headers": [{ "source": "**/*.@(html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }, { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }, { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }] }
}

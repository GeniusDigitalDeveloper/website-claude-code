rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(u) { return signedIn() && request.auth.uid == u; }
    function isSuper() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validTv(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.state is string && d.state.size() <= 60 && d.zone is string && d.zone.size() <= 8
        && d.country is string && d.country.size() <= 60 && d.azanId is string && d.azanId.size() <= 40
        && d.announcements is list && d.announcements.size() <= 30
        && d.slides is list && d.slides.size() <= 10
        && d.anim in ['kenburns', 'zoomout', 'fade'] && d.secs is number && d.secs >= 4 && d.secs <= 30
        && d.plan in ['demo', 'full']
        && (!('preMin' in d) || (d.preMin is number && d.preMin >= 0 && d.preMin <= 30))
        && (!('azanDelayMin' in d) || (d.azanDelayMin is number && d.azanDelayMin >= 0 && d.azanDelayMin <= 30))
        && (!('ringRepeat' in d) || (d.ringRepeat is number && d.ringRepeat >= 1 && d.ringRepeat <= 5))
        && (!('slideList' in d) || (d.slideList is list && d.slideList.size() <= 15))
        && (!('slideSecs' in d) || (d.slideSecs is number && d.slideSecs >= 4 && d.slideSecs <= 60))
        && (!('slideAnim' in d) || d.slideAnim in ['fade', 'slide', 'up', 'zoom', 'flip'])
        && (!('font' in d) || (d.font is string && d.font.size() <= 40))
        && (!('arabicFont' in d) || (d.arabicFont is string && d.arabicFont.size() <= 60))
        && (!('styles' in d) || d.styles is map)
        && (!('azanByPrayer' in d) || d.azanByPrayer is map)
        && (!('theme' in d) || (d.theme is string && d.theme.size() <= 20))
        && (!('azanMute' in d) || d.azanMute is bool)
        && (!('jumaatTime' in d) || (d.jumaatTime is string && d.jumaatTime.size() <= 8))
        && (!('volume' in d) || (d.volume is number && d.volume >= 5 && d.volume <= 100))
        && (!('ringtone' in d) || d.ringtone in ['chime', 'bell', 'beep', 'off']);
    }

    // Penanda admin besar: hanya boleh disemak oleh tuan akaun; tiada tulis dari klien.
    match /admins/{u} { allow get: if me(u); allow list, write: if false; }

    // Rekod pendaftaran: admin besar baca sahaja; masjid urus rekod sendiri.
    match /registry/{u} {
      allow read: if isSuper() || me(u);
      allow create: if me(u)
        && request.resource.data.keys().hasOnly(['name', 'address', 'city', 'postcode', 'state', 'zone', 'country', 'managerName', 'email', 'createdAt'])
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.city is string && request.resource.data.city.size() <= 80
        && request.resource.data.postcode is string && request.resource.data.postcode.size() <= 10
        && request.resource.data.managerName is string && request.resource.data.managerName.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow update: if me(u) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'state', 'zone']);
      allow delete: if false;
    }

    // Konfigurasi paparan TV: baca awam; tulis oleh pemilik (kecuali plan); plan oleh admin besar sahaja.
    match /tv/{u} {
      allow read: if true;
      allow create: if me(u) && validTv(request.resource.data) && request.resource.data.plan == 'demo' && request.resource.data.ownerUid == u;
      allow update: if (me(u) && validTv(request.resource.data) && request.resource.data.plan == resource.data.plan && request.resource.data.ownerUid == resource.data.ownerUid)
        || (isSuper() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan']) && request.resource.data.plan in ['demo', 'full']);
      allow delete: if false;
      match /img/{i} {
        allow read: if true;
        allow create, update: if me(u) && request.resource.data.data is string && request.resource.data.data.size() < 900000 && request.resource.data.order is number;
        allow delete: if me(u);
      }
    }

    // Notifikasi / mesej: masjid <-> Owner (teks sahaja, emoji dibenarkan).
    match /chats/{m} {
      allow read: if me(m) || isSuper();
      allow create, update: if isSuper() || (me(m) && request.resource.data.keys().hasOnly(['name', 'lastText', 'lastAt', 'lastFrom', 'unreadOwner', 'unreadMasjid']) && request.resource.data.lastFrom == 'masjid' || me(m) && request.resource.data.keys().hasOnly(['name', 'lastText', 'lastAt', 'lastFrom', 'unreadOwner', 'unreadMasjid']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadMasjid']));
      allow delete: if false;
      match /msgs/{id} {
        allow read: if me(m) || isSuper();
        allow create: if (isSuper() && request.resource.data.from == 'owner') || (me(m) && request.resource.data.from == 'masjid');
        // sunting/padam mesej sendiri sahaja
        allow update: if ((isSuper() && resource.data.from == 'owner') || (me(m) && resource.data.from == 'masjid')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']);
        allow delete: if (isSuper() && resource.data.from == 'owner') || (me(m) && resource.data.from == 'masjid');
      }
    }

    // Perpustakaan azan: baca awam; tambah/ubah oleh admin besar sahaja.
    // Tetapan lalai sistem (cth. font): baca awam; ubah oleh admin besar sahaja.
    match /config/{c} { allow read: if true; allow write: if isSuper(); }

    match /azan/{a} { allow read: if true; allow write: if isSuper(); }
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$mid": {
        ".write": "$mid.length <= 40",
        ".validate": "newData.hasChildren(['t'])",
        "t": { ".validate": "newData.isNumber() && newData.val() == now" },
        "$other": { ".validate": false }
      }
    }
  }
}

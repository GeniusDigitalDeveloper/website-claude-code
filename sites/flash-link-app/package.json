{
  "name": "flash-link-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Flash Link — pembina halaman link-in-bio (aplikasi desktop Windows)",
  "author": "Genius Digital",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "zip": "node scripts/make-zip.mjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "my.geniusdigital.flashlink",
    "productName": "Flash Link",
    "copyright": "Genius Digital",
    "directories": { "output": "dist" },
    "files": ["main.js", "offline.html", "build/icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Flash-Link-Setup.${ext}"
    }
  }
}

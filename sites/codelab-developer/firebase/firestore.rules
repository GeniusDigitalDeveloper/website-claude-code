rules_version = '2';

// Security Rules CodeLab Developer — fasa integrasi Firebase (belum di-deploy).
// Prinsip: tolak secara lalai; admin ditentukan oleh custom claim `admin == true`
// yang ditetapkan melalui Firebase Admin SDK (bukan oleh klien).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // ---- Statistik ----
    // Bacaan awam (angka agregat sahaja, tiada data peribadi).
    // Penulisan klien dihadkan kepada "+1" pada medan visits. Untuk produksi, sambungkan
    // Firebase App Check atau pindahkan kiraan ke Cloud Function bagi mengelak spam.
    match /stats/total {
      allow read: if true;
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
            && request.resource.data.visits == resource.data.visits + 1);
      allow create, delete: if isAdmin();
    }
    match /stats_daily/{day} {          // day = YYYY-MM-DD (waktu Asia/Kuala_Lumpur)
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
            && request.resource.data.visits == resource.data.visits + 1);
      allow delete: if isAdmin();
    }
    match /stats_monthly/{month} {      // month = YYYY-MM (waktu Asia/Kuala_Lumpur)
      allow read: if isAdmin();
      allow create: if month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
            && request.resource.data.visits == resource.data.visits + 1);
      allow delete: if isAdmin();
    }

    // ---- Pengguna ----
    // registeredUsers pada stats/total dikemas kini oleh Cloud Function (trigger auth.user().onCreate).
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && !('role' in request.resource.data) && !('status' in request.resource.data);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if isAdmin();
    }

    // ---- Konfigurasi & kandungan: baca awam, tulis admin sahaja ----
    match /config/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /content/{doc} { allow read: if true; allow write: if isAdmin(); }

    // ---- Log aktiviti: admin sahaja ----
    match /activity/{id} { allow read, write: if isAdmin(); }

    // ---- Tolak semua yang lain ----
    match /{document=**} { allow read, write: if false; }
  }
}

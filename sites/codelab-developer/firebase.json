{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "site": "genius-digital-40bc9-db0cc",
    "public": ".",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "design-system/**",
      "firebase/firestore.rules",
      "firebase/README.md",
      "README.md"
    ],
    "redirects": [
      {
        "source": "/admin/login",
        "destination": "/admin/login.html",
        "type": 301
      },
      {
        "source": "/admin/dashboard",
        "destination": "/admin/dashboard.html",
        "type": 301
      },
      {
        "source": "/admin/tools",
        "destination": "/admin/tools.html",
        "type": 301
      },
      {
        "source": "/admin/statistics",
        "destination": "/admin/statistics.html",
        "type": 301
      },
      {
        "source": "/admin/users",
        "destination": "/admin/users.html",
        "type": 301
      },
      {
        "source": "/admin/settings",
        "destination": "/admin/settings.html",
        "type": 301
      },
      {
        "source": "/admin/content",
        "destination": "/admin/content.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
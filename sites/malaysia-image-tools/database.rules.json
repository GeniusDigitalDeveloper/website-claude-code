{
  "rules": {
    ".read": false,
    ".write": false,

    "visits": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'izzulmedia01@gmail.com')",
      "users": { ".write": "newData.isNumber() && newData.val() < 1000000000000 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))" },
      "total": { ".write": "newData.isNumber() && newData.val() < 1000000000000 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))" },
      "daily": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          ".write": "newData.isNumber() && newData.val() < 1000000000000 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        }
      },
      "monthly": {
        "$month": {
          ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
          ".write": "newData.isNumber() && newData.val() < 1000000000000 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        }
      },
      "$other": { ".validate": false }
    },

    "stats": {
      ".read": "auth != null && (auth.token.admin === true || auth.token.email === 'izzulmedia01@gmail.com')",
      ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'izzulmedia01@gmail.com')",
      "total": { ".write": "newData.isNumber() && newData.val() < 1000000000000 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))" },
      "tools": {
        "$id": {
          ".validate": "$id.matches(/^[a-z0-9-]{1,40}$/)",
          ".write": "newData.isNumber() && newData.val() < 1000000000000 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        }
      },
      "daily": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9-]{1,40}$/)",
            ".write": "newData.isNumber() && newData.val() < 1000000000000 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
          }
        }
      },
      "$other": { ".validate": false }
    }
  }
}
